# Demonstrates the _history field and version tracking.
# Each modification to this file creates a new history entry.

version: 2
_version: 5

summary: |
  Authentication module for a SaaS platform. Handles user login,
  registration, JWT token management, and role-based access control.

tags: [auth, jwt, security, login]

key_files:
  - path: src/auth/handler.ts
    why: "Auth HTTP handler: login, register, refresh, logout endpoints."
    tags: [auth, handler]
    verified_at: "def5678"

  - path: src/auth/jwt-service.ts
    why: "JWT issuance and validation. Token expiry: access=15m, refresh=7d."
    tags: [jwt, token, security]
    verified_at: "def5678"

  - path: src/auth/middleware.ts
    why: "Express middleware for route protection and role checks."
    tags: [auth, middleware]
    verified_at: "def5678"

contracts:
  - name: "auth-security-requirements"
    scope:
      paths: ["src/auth/*"]
      tags: [auth, security]
    content: |
      SECURITY REQUIREMENTS:
      1. Passwords MUST be hashed with bcrypt (cost factor >= 12).
      2. JWT secrets MUST come from environment variables, never hardcoded.
      3. Refresh tokens MUST be stored server-side and revocable.
    verified_at: "bbb2222"
    locked: true
    owner: security

decisions:
  - id: d001
    title: "JWT over session cookies for API authentication"
    status: accepted
    date: "2025-06-15"
    rationale: |
      JWT allows stateless authentication for the REST API. Mobile clients
      and third-party integrations benefit from bearer tokens.
    alternatives:
      - name: "Session cookies"
        reason_rejected: "Requires shared session store for horizontal scaling"
    verified_at: "ccc3333"

gotchas:
  - warning: "jwt-service.ts uses RS256 in production but HS256 in test. Do not mix."
    tags: [jwt, testing]

commands:
  test: "pnpm test --filter=auth"

# History entries (most recent first, max 20 inline)
_history:
  - version: 5
    timestamp: "2026-03-14T09:15:00Z"
    author: "claude-code"
    session_id: "sess_abc123"
    reason: "Added gotcha about test environment JWT algorithm mismatch"
    checksum: "sha256:f7e8d9c0b1a2938475665748392010ab"
    diff_summary: "added gotchas[0]: RS256/HS256 warning"

