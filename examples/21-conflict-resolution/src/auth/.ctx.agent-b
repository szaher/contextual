# Agent B's version -- also based on v3 (not aware of Agent A's changes).
# Agent B added mfa.ts to key_files and a new MFA contract.

version: 2
_version: 4

summary: |
  Authentication module. Handles user login, registration,
  and JWT token management.

tags: [auth, jwt, security, mfa]

key_files:
  - path: src/auth/handler.ts
    why: "Auth handler with MFA support."
    tags: [auth, handler, mfa]
    verified_at: "ccc3333"

  - path: src/auth/jwt-service.ts
    why: "JWT token management."
    tags: [jwt, token]
    verified_at: "aaa1111"

  - path: src/auth/middleware.ts
    why: "Route protection middleware."
    tags: [auth, middleware]
    verified_at: "aaa1111"

  - path: src/auth/mfa.ts
    why: "Multi-factor authentication: TOTP and SMS verification."
    tags: [mfa, auth, security]
    verified_at: "ccc3333"

contracts:
  - name: "auth-security-requirements"
    scope:
      paths: ["src/auth/*"]
      tags: [auth, security]
    content: |
      SECURITY REQUIREMENTS:
      1. Passwords MUST be hashed with bcrypt (cost factor >= 12).
      2. JWT secrets MUST come from environment variables.
    verified_at: "aaa1111"
    locked: true

  - name: "mfa-requirements"
    scope:
      paths: ["src/auth/mfa*"]
      tags: [mfa, security]
    content: |
      MFA REQUIREMENTS:
      1. TOTP tokens MUST use SHA-256 with 6-digit codes.
      2. SMS codes MUST expire after 5 minutes.
      3. Recovery codes MUST be hashed before storage.
    verified_at: "ccc3333"
    locked: true

commands:
  test: "pnpm test --filter=auth"

_history:
  - version: 4
    timestamp: "2026-03-15T10:40:00Z"
    author: "aider"
    session_id: "sess_xyz789"
    reason: "Added MFA support: mfa.ts key_file and mfa-requirements contract"
    checksum: "sha256:444eee..."
    diff_summary: "added key_files[3]: mfa.ts, added contracts[1]: mfa-requirements, modified key_files[0].why"

  - version: 3
    timestamp: "2026-03-10T11:00:00Z"
    author: "developer"
    session_id: null
    reason: "Added middleware key_file entry"
    checksum: "sha256:333ccc..."
    diff_summary: "added key_files[2]: middleware.ts"
