contracts:
  - name: "auth-security-requirements"
    scope:
      paths: ["src/auth/*"]
      tags: [auth, security]
    content: |
      SECURITY REQUIREMENTS:
      1. Passwords MUST be hashed with bcrypt (cost factor >= 12).
      2. JWT secrets MUST come from environment variables, never hardcoded.
      3. Refresh tokens MUST be stored server-side and revocable.
    verified_at: "abc1234"
    locked: true

decisions:
  - id: d001
    title: "JWT over session cookies for API authentication"
    status: accepted
    date: "2025-06-15"
    rationale: |
      JWT allows stateless authentication for the REST API.
    alternatives:
      - name: "Session cookies"
        reason_rejected: "Requires shared session store"
    verified_at: "abc1234"

